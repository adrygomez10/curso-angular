{
  "name": "curso-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --poll 1000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.spec.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "jsdom": "30.1.3",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
